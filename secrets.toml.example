# Bu dosya bir ŞABLONdur — gerçek API key'lerini buraya YAZMA.
#
# Yerel bilgisayarında kullanmak için:
# 1. Bu dosyanın yanında ".streamlit" adında bir klasör oluştur
# 2. İçine "secrets.toml" adında bir dosya oluştur (bu şablonu kopyala)
# 3. Aşağıdaki değerleri kendi gerçek API key'lerinle değiştir
# 4. ".streamlit/secrets.toml" dosyasını ASLA GitHub'a yükleme (.gitignore bunu engelliyor)
#
# Streamlit Cloud'da kullanmak için:
# 1. share.streamlit.io'da uygulamanın ayarlarına git
# 2. "Secrets" bölümüne bu içeriği (gerçek key'lerinle) yapıştır

FRED_API_KEY = "buraya-fred-api-keyini-yaz"
EVDS_API_KEY = "buraya-evds-api-keyini-yaz"
ALPHA_VANTAGE_API_KEY = "buraya-alpha-vantage-keyini-yaz"
